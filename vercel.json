{
  "builds": [
    {
      "src": "frontend-vite/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "build": {
    "env": {
      "VITE_BACKEND_URL": "https://us-central1-rtaip-af1a8.cloudfunctions.net/api"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}