# Public (browser) settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Basemap style. Default is a free dark style. For commercial use point this at your own tiles.
NEXT_PUBLIC_MAP_STYLE_URL=

# Server only
# Optional keys that unlock extra data. The app works without any of them.
# Aircraft come from free community ADS-B feeds. OpenSky is only used as a fallback when both are set.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
# Shared secret for scheduled ingestion calls (Supabase cron or Vercel cron).
CRON_SECRET=
